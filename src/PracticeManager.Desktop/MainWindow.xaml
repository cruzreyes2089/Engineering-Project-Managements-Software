<Window x:Class="PracticeManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CRC Practice Manager — Development 0.4.12" Height="780" Width="1160" MinHeight="600" MinWidth="850" FontFamily="Segoe UI" FontSize="14" Background="#F1F4F8" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
 <Border Background="#142D46" Padding="24,0"><DockPanel LastChildFill="True"><Button x:Name="SignOut" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Sign out" Click="SignOut_Click" Visibility="Collapsed"/><StackPanel VerticalAlignment="Center"><TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="CRC PRACTICE MANAGER"/><TextBlock Foreground="#B8CADC" FontSize="12" Text="NATIVE WINDOWS · DEVELOPMENT BUILD 0.4.12"/></StackPanel></DockPanel></Border>
 <Grid Grid.Row="1">
  <Grid x:Name="LoginPanel" Margin="20"><Border Background="White" CornerRadius="8" Width="430" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="LoginHeading" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel x:Name="SetupPanel"><TextBlock Text="Company name"/><TextBox x:Name="Firm" MaxLength="150"/><TextBlock Text="Client number prefix"/><TextBox x:Name="Prefix" Text="CL" MaxLength="10"/></StackPanel><TextBlock Text="Username"/><TextBox x:Name="Username" MaxLength="60"/><TextBlock Text="Password"/><PasswordBox x:Name="Password" MaxLength="256"/><StackPanel x:Name="ConfirmPanel"><TextBlock Text="Confirm password (14–256 characters)"/><PasswordBox x:Name="Confirm" MaxLength="256"/></StackPanel><Button x:Name="LoginButton" Content="Sign in" IsDefault="True" Click="Login_Click" Margin="0,10,0,0"/><Button x:Name="RequiredPasswordButton" Content="Change temporary password" Click="RequiredPassword_Click"/><TextBlock x:Name="LoginMessage" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#A23A28"/></StackPanel></Border></Grid>
  <Grid x:Name="Workspace" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#203B56" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FirmLabel" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,22"/><Button Content="Dashboard" Click="Dashboard_Click" Margin="0,0,0,8"/><Button x:Name="CrmNav" Content="Clients &amp; contacts" Click="Crm_Click" Margin="0,0,0,8"/><Button x:Name="AccountingNav" Content="Accounting connection" Click="Accounting_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="EngagementNav" Content="Proposals &amp; projects" Click="Engagement_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="StaffNav" Content="Staff &amp; permissions" Click="Staff_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="WorkNav" Content="My work" Click="Work_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="ScheduleNav" Content="Staff schedule" Click="Schedule_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="TimeNav" Content="My time &amp; expenses" Click="Time_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="ReviewNav" Content="Work review &amp; billing" Click="Review_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="InvoiceNav" Content="Invoice preparation" Click="Invoice_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="ReportsNav" Content="Reports" Click="Reports_Click" Margin="0,0,0,8" IsEnabled="False"/><Button x:Name="RecoveryNav" Content="Recovery copy" Click="Recovery_Click" Margin="0,0,0,8" IsEnabled="False"/><TextBlock Text="PLANNED MODULES" Foreground="#B8CADC" FontSize="11" Margin="0,22,0,8"/><TextBlock Text="Collections" Foreground="#CAD7E3" LineHeight="31" LineStackingStrategy="BlockLineHeight"/></StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Margin="24"><StackPanel x:Name="DashboardPanel"><TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" Foreground="#142D46"/><TextBlock Text="Local practice workspace — development preview" Foreground="#55697C" Margin="0,5,0,20"/><Border Background="White" Padding="22" CornerRadius="8"><StackPanel><TextBlock Text="Client register" FontSize="16"/><TextBlock x:Name="ClientCount" FontSize="38" Foreground="#234D70" FontWeight="SemiBold"/><TextBlock Text="Proposal and pending project foundation is available. Project authorization and finance remain under development." TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
    <Grid x:Name="CrmPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Clients &amp; contacts" FontSize="30" FontWeight="SemiBold" Foreground="#142D46"/>
    <DockPanel Grid.Row="1" Margin="0,12,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="NewClientButton" Content="New client" Click="NewClient_Click"/><Button x:Name="EditClientButton" Content="Edit selected" Click="EditClient_Click"/></StackPanel><TextBox x:Name="Search" TextChanged="Search_Changed" MaxLength="150" ToolTip="Search client number, name or email"/></DockPanel>
    <DataGrid x:Name="ClientGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Client_Changed" CanUserAddRows="False" Background="White" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="125"/><DataGridTextColumn Header="Client" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="190"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="135"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="3" Margin="0,16,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="NewContactButton" Content="New contact" Click="NewContact_Click"/><Button x:Name="EditContactButton" Content="Edit contact" Click="EditContact_Click"/></StackPanel><TextBlock x:Name="ContactsHeading" Text="Select a client to view contacts" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <DataGrid x:Name="ContactGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Contact_Changed" CanUserAddRows="False" Background="White" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="120"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="190"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="135"/><DataGridCheckBoxColumn Header="Primary" Binding="{Binding Primary}" Width="70"/></DataGrid.Columns></DataGrid></Grid>
   </Grid>
  </Grid>
 </Grid><Border Grid.Row="2" Background="#E2E9F0" Padding="16,6"><TextBlock x:Name="Status" Foreground="#354B60" Text="Development only · Do not use live client information"/></Border></Grid>
</Window>
